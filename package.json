{
  "name": "dsh-browser-control",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Drive the built-in Harness sidebar browser like ZCode: an ARIA snapshot as locator ground truth, one state-changing action per observation, trusted input, and real screenshots",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neilweixing/dsh-browser-control.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-browser",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "test": "node test/agent.smoke.mjs && node --test test/broker.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
